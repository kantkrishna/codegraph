# docker-compose.yml
# This docker-compose file defines a multi-container application with three services:
# web, neo4j, and postgres. The web service is built from the local Dockerfile and
# depends on the neo4j and postgres services. The neo4j service uses the official Neo4j
# image with the APOC plugin enabled, while the postgres service uses a custom image
# that includes pgvector support. Each service has its own environment variables and
# volume mappings for data persistence.
# version: "3.8"
services:
  neo4j:
    image: neo4j:5.15-enterprise
    container_name: codegraph-neo4j
    ports:
      - "7474:7474"
      - "7687:7687"
    environment:
      - NEO4J_AUTH=${NEO4J_USER:-neo4j}/${NEO4J_PASSWORD:-codegraph_secret}
      - NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
      - NEO4J_PLUGINS=["apoc"]
      - NEO4J_dbms_security_procedures_unrestricted=apoc.*
      - NEO4J_dbms_security_procedures_allowlist=apoc.*
    volumes:
      - ./.docker-data/neo4j/data:/data
      - ./.docker-data/neo4j/logs:/logs
    healthcheck:
      test: ["CMD-SHELL", "cypher-shell -u ${NEO4J_USER:-neo4j} -p ${NEO4J_PASSWORD:-codegraph_secret} 'RETURN 1;' || exit 1"]
      interval: 10s
      timeout: 10s
      retries: 5
      start_period: 30s
    restart: always
  postgres:
    image: ankane/pgvector:v0.5.1
    container_name: codegraph-postgres
    ports:
      - "5432:5432"
    environment:
      - POSTGRES_USER=${POSTGRES_USER:-postgres}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-codegraph_secret}
      - POSTGRES_DB=${POSTGRES_DB:-codegraph}
    volumes:
      - ./.docker-data/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-codegraph}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: always
  jaeger:
    image: jaegertracing/all-in-one:latest
    container_name: codegraph-jaeger
    environment:
      - COLLECTOR_OTLP_ENABLED=true
    ports:
      # Jaeger Web UI
      - "16686:16686"
      # OTLP gRPC (Backend Exporter target)
      - "4317:4317"
      # OTLP HTTP
      - "4318:4318"
    restart: unless-stopped
  kafka:
    image: apache/kafka:3.7.2
    container_name: codegraph-kafka
    ports:
      - "9092:9092"
    environment:
      - KAFKA_NODE_ID=1
      - KAFKA_PROCESS_ROLES=broker,controller
      - KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
      # FIX: Dual Listeners for Docker Network vs. Host Machine
      - KAFKA_LISTENERS=INTERNAL://0.0.0.0:29092,EXTERNAL://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
      - KAFKA_ADVERTISED_LISTENERS=INTERNAL://kafka:29092,EXTERNAL://localhost:9092
      - KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT
      - KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
      - KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093
    volumes:
      - ./.docker-data/kafka:/apache/kafka
  kafka-ui:
    image: provectuslabs/kafka-ui:latest
    container_name: codegraph-kafka-ui
    ports:
      - "8080:8080"
    environment:
      - KAFKA_CLUSTERS_0_NAME=CodeGraph-Local
      # FIX: Connect via the INTERNAL Docker network listener port
      - KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:29092
    depends_on:
      - kafka
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
  api:
    build: .
    command: uvicorn backend.main:app --host 0.0.0.0 --port 8000
    ports:
      - "8000:8000"
    env_file:
      - .env
    environment:
      - REDIS_URL=redis://redis:6379
      - NEO4J_URI=bolt://neo4j:7687
      - DATABASE_URL=postgresql://postgres:codegraph_secret@postgres:5432/codegraph
      - OTLP_ENDPOINT=http://jaeger:4317
    depends_on:
      postgres:
        condition: service_healthy
      neo4j:
        condition: service_healthy
      redis:
        condition: service_started
  worker:
    build: .
    # command: arq backend.worker.WorkerSettings
    command: ["uv", "run", "arq", "backend.worker.WorkerSettings"]
    env_file:
      - .env
    environment:
      - REDIS_URL=redis://redis:6379
      - KAFKA_URL=kafka:29092
      - KAFKA_BOOTSTRAP_SERVERS=kafka:29092
    depends_on:
      - redis
      - kafka
    volumes:
      # Required if we want to test locally without rebuilding images
      - .:/app
      - /app/.venv
volumes:
  neo4j_data:
    driver: local
  neo4j_logs:
    driver: local
  postgres_data:
    driver: local
  kafka_data:
    driver: local
</file>

<file path="pyproject.toml">
[project]
name = "codegraph"
version = "0.1.0"
description = "Enterprise AI-Augmented Engineering Platform"
readme = "README.md"
authors = [
    { name = "Krishna Kant", email = "kantkrishna@hotmail.com" }
]
requires-python = ">=3.14"
dependencies = [
    "aiokafka>=0.14.0",
    "arq>=0.28.0",
    "fastapi>=0.141.1",
    "httpx2>=2.10.0",
    "neo4j>=6.2.0",
    "opentelemetry-api>=1.44.0",
    "opentelemetry-exporter-otlp>=1.44.0",
    "opentelemetry-instrumentation-fastapi>=0.65b0",
    "opentelemetry-instrumentation-sqlalchemy>=0.65b0",
    "opentelemetry-sdk>=1.44.0",
    "pgvector>=0.5.0",
    "prometheus-client>=0.26.0",
    "psycopg2-binary>=2.9.12",
    "pydantic>=2.13.4",
    "pydantic-settings>=2.15.0",
    "redis>=5.3.1",
    "sqlalchemy>=2.0.51",
    "structlog>=26.1.0",
    "tree-sitter>=0.26.0",
    "tree-sitter-python>=0.25.0",
    "tree-sitter-typescript>=0.23.2",
    "uvicorn>=0.52.1",
]

[project.scripts]
codegraph = "codegraph:main"

[build-system]
requires = ["uv_build>=0.12.3,<0.13.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "httpx>=0.28.1",
    "mypy>=2.3.0",
    "pyjwt>=2.13.0",
    "pytest>=9.1.1",
    "pytest-asyncio>=1.4.0",
    "pytest-cov>=7.1.0",
    "pytest-mock>=3.15.1",
    "pyyaml>=6.0.3",
    "ruff>=0.16.2",
    "types-pyyaml>=6.0.12.20260724",
